#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 U.S. Federal Government (in countries where recognized)
# SPDX-License-Identifier: Apache-2.0
# octo-pod-identity — write /etc/octo-pod from an unpacked token. Nothing else.
#
#   octo-pod-identity write <unpacked-token-dir>
#
# Does NOT install packages, enrol anything, or converge the pod. It only turns a verified
# token into this pod's identity on disk, which is the one thing an upgrade must never
# touch. Existing files are left alone, so re-running is safe.
set -uo pipefail

# OCTO_POD_ETC, like octo-pod and octo-pod-declare. This was hardcoded, so `join` (which
# does honour it) wrote its inventory path from one value and this tool wrote the files
# at another — and the tool could only ever be exercised as root against the real
# identity, which is why its behaviour went untested.
ETC="${OCTO_POD_ETC:-/etc/octo-pod}"
FABRIC_DIR="${OCTO_FABRIC_DIR:-/etc/fabric-uplink}"
die() { printf '\nERROR: %s\n' "$*" >&2; exit 1; }

[ "${1:-}" = write ] || { sed -n '2,8p' "$0" >&2; exit 1; }
SRC="${2:?usage: octo-pod-identity write <unpacked-token-dir>}"
[ -f "$SRC/manifest.yaml" ] || die "$SRC has no manifest.yaml — unpack a token there first"
# Root is needed to write under /etc and nowhere else. An overridden ETC is a test run.
case "$ETC" in
  /etc/*) [ "$(id -u)" = 0 ] || die "run with sudo" ;;
esac

# The path and the key go in as arguments, never into the program text: a token
# unpacked under a directory with a quote in its name was a SyntaxError here, which the
# line below then reported as a manifest with no pod_name.
get() {
  python3 -c 'import sys, yaml; print((yaml.safe_load(open(sys.argv[1])) or {}).get(sys.argv[2], ""))' \
    "$SRC/manifest.yaml" "$1"
}
POD="$(get pod_name)";    [ -n "$POD" ] || die "manifest has no pod_name"
# POD BECOMES A PATH under $ETC/host_vars and the inventory host, so it is held to the
# rule 'octo-pod init' enforces before it is either. A token is input: a pod_name of
# '../../cron.d' would otherwise have root write these files wherever it points.
[[ "$POD" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "pod_name '$(printf '%s' "$POD" | LC_ALL=C tr -cd '[:print:]' | head -c 80)' in $SRC/manifest.yaml must be lowercase letters, digits and dashes, starting with a letter or digit. Nothing was written."
ANCHOR="$(get upstream_anchor)"

install -d -m 0755 "$ETC" "$ETC/host_vars/$POD"

if [ -f "$ETC/inventory.ini" ]; then
  echo "kept   $ETC/inventory.ini"
else
  # ansible_connection=local: the pod converges itself. No control node, no SSH, works
  # with no route back to us — which matters when the site is behind someone else's NAT.
  cat > "$ETC/inventory.ini" <<INV
# Generated by octo-pod-identity. This pod converges itself.
[octopod]
$POD ansible_connection=local

[octopod:vars]
ansible_python_interpreter=/usr/bin/python3
INV
  echo "wrote  $ETC/inventory.ini"
fi

write_once() {  # path, content — never clobber operator edits
  if [ -f "$1" ]; then echo "kept   $1"; else printf '%s' "$2" > "$1"; echo "wrote  $1"; fi
}

write_once "$ETC/host_vars/$POD/10-pod.yml" "\
# This pod's identity. Yours; never overwritten by a package upgrade.
pen_id: \"$POD\"
fabric_slot_anchor: \"$ANCHOR\"

# THE RELEASE GATE. A namespace leaves this pod only if it is listed here AND that
# publisher's own release.to_fabric is true. Two edits in two files, deliberately.
bridge_allow: \"raw/octo/**\"

# THE DOWNWARD GATE, the mirror of bridge_allow. Fabric data reaches a destination only
# if its keys are listed in downlink_allow AND that destination's own release.from_fabric
# is true. Empty means nothing comes down. 'octo-pod egress release' makes both edits.
downlink_allow: \"\"
"

write_once "$ETC/host_vars/$POD/00-site.yml" "\
# The leg your sensors reach you on. Fill these in before adding arms: ip -br addr
lan_iface: \"\"
lan_ip: \"\"
lan_prefix: 24
network_managed: true     # false if something else already owns this NIC
"

# Emitted by yaml.safe_dump, not pasted as a string: fabric_host_pins is a list of
# mappings, and hand-quoting one into a heredoc is a bug waiting to happen.
fabric() {
  python3 - "$SRC/manifest.yaml" <<'PY'
import sys, urllib.parse, yaml
m = yaml.safe_load(open(sys.argv[1])) or {}
url = m.get("netbird_management_url", "") or ""
print(yaml.safe_dump({
    # The host alone: bootstrap builds the URL back up when no --mgmt is passed.
    "netbird_mgmt_host": urllib.parse.urlsplit(url).hostname or "",
    "fabric_endpoint": m.get("fabric_endpoint", "") or "",
    "fabric_host_pins": m.get("fabric_host_pins", []) or [],
    "fabric_portal_url": m.get("fabric_portal_url", "") or "",
    "octo_repo_url": m.get("octo_repo_url", "") or "",
    "octo_apt_repo_url": m.get("octo_apt_repo_url", "") or "",
}, sort_keys=False, default_flow_style=False), end="")
PY
}

write_once "$ETC/host_vars/$POD/05-fabric.yml" "\
# THE FABRIC THIS POD JOINS — mesh, upstream, updates. From the token.
#
# These name one deployment's hosts, which is why they are here and not in the platform
# layer: that layer ships unchanged to every site, and no site should be handed the
# addresses of a fabric it is not part of.
#
# Empty is legitimate. A pod that captures and retains locally needs none of them, and
# each is checked at the step that actually uses it rather than at the top of a run.
#   netbird_mgmt_host   the mesh, when 'join --mgmt' does not name one
#   fabric_endpoint       tls/<zenoh host>:7447 — where the bridge publishes
#   fabric_host_pins      mesh DNS for the above; resolvable nowhere else
#   fabric_portal_url     where topics and schemas are registered
#   octo_repo_url       release files (LATEST + tarball) for 'octo-pod upgrade'
#   octo_apt_repo_url   an APT repository, if one exists. Not the same surface —
#                       an apt source pointed at the file surface breaks all of apt.
$(fabric)"

write_once "$ETC/host_vars/$POD/20-peers.yml" "peers: []
"
write_once "$ETC/host_vars/$POD/30-arms.yml" "arms: []
"
write_once "$ETC/host_vars/$POD/40-egress.yml" "egress: []
"

# Upstream slot material, if the token carried one.
if [ -d "$SRC/slot" ]; then
  install -d -m 0700 "$FABRIC_DIR"
  install -m 0644 "$SRC"/slot/*-cert.pem  "$FABRIC_DIR/" 2>/dev/null || true
  install -m 0600 "$SRC"/slot/*-key.pem   "$FABRIC_DIR/" 2>/dev/null || true
  install -m 0644 "$SRC"/slot/ca-root.pem "$FABRIC_DIR/fabric-ca-root.pem" 2>/dev/null || true
  echo "wrote  $FABRIC_DIR (upstream slot)"
else
  echo "note   token carries no slot — this pod will not bridge upstream"
fi

echo
echo "identity written for pod '$POD'."
