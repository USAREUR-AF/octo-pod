key  class_filter_type                                                            string  -  "ClassFilter.type (string): Type of classification to filter on"
key  class_filter_priority                                                        int     -  "ClassFilter.priority (enum DiscreteThreshold: 0=DISCRETE_THRESHOLD_UNSPECIFIED, 1=DISCRETE_THRESHOLD_LOW, 2=DISCRETE_THRESHOLD_MEDIUM, 3=DISCRETE_THRESHOLD_HIGH): Priority of filter"
key  sub_class_filter_parameter_name                                              string  -  "Parameter.name (string): Name of the parameter to filter"
key  sub_class_filter_parameter_operator                                          int     -  "Parameter.operator (enum Operator: 0=OPERATOR_UNSPECIFIED, 1=OPERATOR_ALL, 2=OPERATOR_GREATER_THAN, 3=OPERATOR_LESS_THAN, 4=OPERATOR_EQUAL): Operator to be filtered on"
key  sub_class_filter_parameter_value                                             float   -  "Parameter.value (float): Threshold"
key  sub_class_filter_type                                                        string  -  "SubClassFilter.type (string): Type of classification to filter on"
key  sub_class_filter_priority                                                    int     -  "SubClassFilter.priority (enum DiscreteThreshold: 0=DISCRETE_THRESHOLD_UNSPECIFIED, 1=DISCRETE_THRESHOLD_LOW, 2=DISCRETE_THRESHOLD_MEDIUM, 3=DISCRETE_THRESHOLD_HIGH): Priority of filter"
key  behaviour_filter_parameter_name                                              string  -  "Parameter.name (string): Name of the parameter to filter"
key  behaviour_filter_parameter_operator                                          int     -  "Parameter.operator (enum Operator: 0=OPERATOR_UNSPECIFIED, 1=OPERATOR_ALL, 2=OPERATOR_GREATER_THAN, 3=OPERATOR_LESS_THAN, 4=OPERATOR_EQUAL): Operator to be filtered on"
key  behaviour_filter_parameter_value                                             float   -  "Parameter.value (float): Threshold"
key  behaviour_filter_type                                                        string  -  "BehaviourFilter.type (string): Type of behaviour to filter on"
key  behaviour_filter_priority                                                    int     -  "BehaviourFilter.priority (enum DiscreteThreshold: 0=DISCRETE_THRESHOLD_UNSPECIFIED, 1=DISCRETE_THRESHOLD_LOW, 2=DISCRETE_THRESHOLD_MEDIUM, 3=DISCRETE_THRESHOLD_HIGH): Priority of filter"
key  task_ack_reason_item                                                         string  -  "TaskAck.reason (string): Reason(s) for the rejection if task is rejected, completed, or failed; one item of the repeated field"
key  associated_detection_timestamp_seconds                                       int     -  "Timestamp.seconds (int64): seconds of UTC time since the Unix epoch"
key  associated_detection_timestamp_nanos                                         int     -  "Timestamp.nanos (int32): non-negative fractions of a second, in nanoseconds"
key  associated_detection_node_id                                                 string  -  "AssociatedDetection.node_id (string): ULID for the node where the assoicated detection has originiated"
key  associated_detection_object_id                                               string  -  "AssociatedDetection.object_id (string): ULID for the object detected in the environment"
key  associated_detection_association_type                                        int     -  "AssociatedDetection.association_type (enum AssociationRelation: 0=ASSOCIATION_RELATION_UNSPECIFIED, 1=ASSOCIATION_RELATION_NO_RELATION, 2=ASSOCIATION_RELATION_PARENT, 3=ASSOCIATION_RELATION_CHILD, 4=ASSOCIATION_RELATION_SIBLING): Relationship of associated detection to this message"
key  alert_ack_reason_item                                                        string  -  "AlertAck.reason (string): Reason(s) why alert was not accepted; one item of the repeated field"
key  error_error_message_item                                                     string  -  "Error.error_message (string): Description of the error being reported, this field is an array to allow multiple errors to be reported in one go; one item of the repeated field"
key  track_object_info_type                                                       string  -  "TrackObjectInfo.type (string): The type of object_info being reported (e.g. colour)"
key  track_object_info_value                                                      string  -  "TrackObjectInfo.value (string): The value of the object_info being reported (e.g. red)"
key  track_object_info_error                                                      float   -  "TrackObjectInfo.error (float): Any error associated with the object_info"
key  behaviour_type                                                               string  -  "Behaviour.type (string): Behviouar of the detected object being reported"
key  behaviour_confidence                                                         float   -  "Behaviour.confidence (float): Confidence (0-1) that this is the correct behvaiour of the detected object"
key  signal_amplitude                                                             float   -  "Signal.amplitude (float): Peak amplitude of the signal being reported"
key  signal_start_frequency                                                       float   -  "Signal.start_frequency (float): Lowest frequency of the band being reported"
key  signal_centre_frequency                                                      float   -  "Signal.centre_frequency (float): Centre frequency of the band being reported"
key  signal_stop_frequency                                                        float   -  "Signal.stop_frequency (float): Highest frequency of the band being reported"
key  signal_pulse_duration                                                        float   -  "Signal.pulse_duration (float): Pulse duration of the signal being reported"
key  derived_detection_timestamp_seconds                                          int     -  "Timestamp.seconds (int64): seconds of UTC time since the Unix epoch"
key  derived_detection_timestamp_nanos                                            int     -  "Timestamp.nanos (int32): non-negative fractions of a second, in nanoseconds"
key  derived_detection_node_id                                                    string  -  "DerivedDetection.node_id (string): UUID for the node where the assoicated detection has originiated"
key  derived_detection_object_id                                                  string  -  "DerivedDetection.object_id (string): ULID for the object detected in the environment"
# Lists (engine-spec 0.7): one per repeated field the pack maps as a `group`. The keys
# an item holds are keys of this module, named from the item's message type.
list registration_node_definition                                        "Registration.node_definition (repeated NodeDefinition): Type of the node; each item is one NodeDefinition message"
list node_definition_node_sub_type                                       "NodeDefinition.node_sub_type (repeated string): further description of node type; each item holds sapient.node_definition_node_sub_type_item"
list registration_capabilities                                           "Registration.capabilities (repeated Capability): Node's capabilities; each item is one Capability message"
list status_definition_status_report                                     "StatusDefinition.status_report (repeated StatusReport): Additional heartbeat report definitions; each item is one StatusReport message"
list registration_mode_definition                                        "Registration.mode_definition (repeated ModeDefinition): Detection report and tasking definitons; each item is one ModeDefinition message"
list mode_definition_mode_parameter                                      "ModeDefinition.mode_parameter (repeated ModeParameter): Additional parameters that can be passed to the mode during tasking; each item is one ModeParameter message"
list mode_definition_detection_definition                                "ModeDefinition.detection_definition (repeated DetectionDefinition): Definition of detection reports sent while in this mode; each item is one DetectionDefinition message"
list detection_definition_detection_performance                          "DetectionDefinition.detection_performance (repeated PerformanceValue): detection performance definition; each item is one PerformanceValue message"
list detection_definition_detection_report                               "DetectionDefinition.detection_report (repeated DetectionReport): Detection report defintion; each item is one DetectionReport message"
list detection_definition_detection_class_definition                     "DetectionDefinition.detection_class_definition (repeated DetectionClassDefinition): Classes able to be reported in this detection report; each item is one DetectionClassDefinition message"
list detection_class_definition_class_performance                        "DetectionClassDefinition.class_performance (repeated PerformanceValue): Performance values associated with the classifications in the detection; each item is one PerformanceValue message"
list detection_class_definition_class_definition                         "DetectionClassDefinition.class_definition (repeated ClassDefinition): Classifications the ASM is able to provide; each item is one ClassDefinition message"
list detection_class_definition_taxonomy_dock_definition                 "DetectionClassDefinition.taxonomy_dock_definition (repeated TaxonomyDockDefinition): List of docking points for taxonomy extensions; each item is one TaxonomyDockDefinition message"
list detection_definition_behaviour_definition                           "DetectionDefinition.behaviour_definition (repeated BehaviourDefinition): Behaviours able to be reported in the detection report; each item is one BehaviourDefinition message"
list detection_definition_geometric_error_performance_value              "GeometricError.performance_value (repeated PerformanceValue): A list of types and values; each item is one PerformanceValue message"
list mode_definition_task_region_definition_region_type                  "RegionDefinition.region_type (repeated RegionType): Types of region; each item holds sapient.region_definition_region_type_item"
list mode_definition_task_region_definition_region_area                  "RegionDefinition.region_area (repeated LocationType): Location types used for the area that defines the region; each item is one LocationType message"
list mode_definition_task_region_definition_class_filter_definition      "RegionDefinition.class_filter_definition (repeated ClassFilterDefinition): Filters that can be applied to the region for classes; each item is one ClassFilterDefinition message"
list mode_definition_task_region_definition_behaviour_filter_definition  "RegionDefinition.behaviour_filter_definition (repeated BehaviourFilterDefinition): Filters that can be applied to the region for behaviours; each item is one BehaviourFilterDefinition message"
list mode_definition_task_command                                        "TaskDefinition.command (repeated Command): Commands that can be issued as part of this task; each item is one Command message"
list registration_dependent_nodes                                        "Registration.dependent_nodes (repeated string): This field allows the dependent (child) nodes (if present) of the current node to be specified; each item holds sapient.registration_dependent_nodes_item"
list registration_reporting_region                                       "Registration.reporting_region (repeated LocationOrRangeBearing): This field is used within a hierarchy of fusion nodes for a (child) fusion node to tell its parent fusion node the region it is reporting from; each item is one LocationOrRangeBearing message"
list location_or_range_bearing_location_list_locations                   "LocationList.locations (repeated Location): List of locations used to define a region; each item is one Location message"
list registration_config_data                                            "Registration.config_data (repeated ConfigurationData): This sub-message is used to report node configuration data, e.g. Manufacturer, Model, etc; each item is one ConfigurationData message"
list registration_ack_ack_response_reason                                "RegistrationAck.ack_response_reason (repeated string): This field can be used to communicate the (operational) reason(s) for rejecting the Registration Message (one per array element); each item holds sapient.registration_ack_ack_response_reason_item"
list field_of_view_location_list_locations                               "LocationList.locations (repeated Location): List of locations used to define a region; each item is one Location message"
list status_report_obscuration                                           "StatusReport.obscuration (repeated LocationOrRangeBearing): Area that the ASM cannot cover; each item is one LocationOrRangeBearing message"
list status_report_status                                                "StatusReport.status (repeated Status): Information about the ASM or the envionrment; each item is one Status message"
list status_report_coverage                                              "StatusReport.coverage (repeated LocationOrRangeBearing): The coverage field has been made repeated so that a Fusion Node can report the total coverage from its child/edge nodes; each item is one LocationOrRangeBearing message"
list task_region                                                         "Task.region (repeated Region): Area tasking is to be applied (such as a system implementing geo-fencing); each item is one Region message"
list region_region_area_location_list_locations                          "LocationList.locations (repeated Location): List of locations used to define a region; each item is one Location message"
list region_class_filter                                                 "Region.class_filter (repeated ClassFilter): Filter for classifications detected in the region; each item is one ClassFilter message"
list class_filter_sub_class_filter                                       "ClassFilter.sub_class_filter (repeated SubClassFilter): Sub-classes to filter on; each item is one SubClassFilter message"
list region_behaviour_filter                                             "Region.behaviour_filter (repeated BehaviourFilter): Filter for behaviours detected in the region; each item is one BehaviourFilter message"
list command_location_list_locations                                     "LocationList.locations (repeated Location): List of locations used to define a region; each item is one Location message"
list command_move_to_locations                                           "LocationList.locations (repeated Location): List of locations used to define a region; each item is one Location message"
list command_patrol_locations                                            "LocationList.locations (repeated Location): List of locations used to define a region; each item is one Location message"
list task_ack_reason                                                     "TaskAck.reason (repeated string): Reason(s) for the rejection if task is rejected, completed, or failed; each item holds sapient.task_ack_reason_item"
list alert_associated_file                                               "Alert.associated_file (repeated AssociatedFile): URL linking to any files associated with the alert; each item is one AssociatedFile message"
list alert_associated_detection                                          "Alert.associated_detection (repeated AssociatedDetection): Detections associated with the alert; each item is one AssociatedDetection message"
list alert_ack_reason                                                    "AlertAck.reason (repeated string): Reason(s) why alert was not accepted; each item holds sapient.alert_ack_reason_item"
list error_error_message                                                 "Error.error_message (repeated string): Description of the error being reported, this field is an array to allow multiple errors to be reported in one go; each item holds sapient.error_error_message_item"
list detection_report_track_info                                         "DetectionReport.track_info (repeated TrackObjectInfo): Additional information about the track as defined in the ASM's registration message; each item is one TrackObjectInfo message"
list detection_report_object_info                                        "DetectionReport.object_info (repeated TrackObjectInfo): Additional information about the detected object as defined in the ASM's registration message; each item is one TrackObjectInfo message"
list detection_report_behaviour                                          "DetectionReport.behaviour (repeated Behaviour): Behavioural information about the detected object; each item is one Behaviour message"
list detection_report_associated_file                                    "DetectionReport.associated_file (repeated AssociatedFile): URLs to any additional files relating to the object which hosted on the network; each item is one AssociatedFile message"
list detection_report_signal                                             "DetectionReport.signal (repeated Signal): RF signal information about the detected object; each item is one Signal message"
list detection_report_associated_detection                               "DetectionReport.associated_detection (repeated AssociatedDetection): Other SAPIENT detections associated with this detection; each item is one AssociatedDetection message"
list detection_report_derived_detection                                  "DetectionReport.derived_detection (repeated DerivedDetection): Other SAPIENT detections dervied from this detection; each item is one DerivedDetection message"
